        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Closet Finder verwendet die Kamera, um deine Kleidung zu fotografieren."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Closet Finder usa la fotocamera per fotografare i tuoi vestiti."
