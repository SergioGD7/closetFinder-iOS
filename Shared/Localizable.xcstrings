    "Al guardar se abre otra prenda nueva con la misma ubicación, persona y temporada. Ideal para fotografiar un cajón entero.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving opens another new item with the same place, person and season. Ideal for photographing a whole drawer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À l’enregistrement, un nouveau vêtement s’ouvre avec le même emplacement, la même personne et la même saison. Idéal pour photographier un tiroir entier."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Sichern öffnet sich ein neues Kleidungsstück mit gleichem Ort, gleicher Person und Saison. Ideal, um eine ganze Schublade zu fotografieren."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvando si apre un nuovo capo con lo stesso posto, persona e stagione. Ideale per fotografare un intero cassetto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao salvar, abre-se outra peça nova com o mesmo lugar, pessoa e estação. Ideal para fotografar uma gaveta inteira."
          }
        }
      }
    },
