    "Mide la prenda extendida en plano. Con tus medidas corporales, la app te dirá si te queda bien.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measure the item laid flat. With your body measurements, the app will tell you whether it fits."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesurez le vêtement à plat. Avec vos mensurations, l’app vous dira s’il vous va."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Miss das Kleidungsstück flach liegend. Mit deinen Körpermaßen sagt dir die App, ob es passt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Misura il capo steso in piano. Con le tue misure, l’app ti dirà se ti sta bene."
