    "Se borrarán con sus fotos y desaparecerán de los looks. No se puede deshacer.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They’ll be deleted with their photos and removed from looks. This can’t be undone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ils seront supprimés avec leurs photos et retirés des looks. Action irréversible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie werden samt Fotos gelöscht und aus den Looks entfernt. Das kann nicht rückgängig gemacht werden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verranno eliminati con le foto e tolti dai look. L’azione non può essere annullata."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Serão apagadas com as fotos e sairão dos looks. Não é possível desfazer."
          }
        }
      }
    },
    "Se borrarán la prenda y su foto. No se puede deshacer.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The item and its photo will be deleted. This can’t be undone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le vêtement et sa photo seront supprimés. Action irréversible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Kleidungsstück und sein Foto werden gelöscht. Das kann nicht rückgängig gemacht werden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il capo e la sua foto verranno eliminati. L’azione non può essere annullata."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A peça e a foto serão apagadas. Não é possível desfazer."
          }
        }
      }
    },
    "Se eliminará también todo lo que contiene. Las prendas quedarán sin ubicación.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything inside will also be deleted. Items will be left without a place."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout son contenu sera aussi supprimé. Les vêtements n’auront plus d’emplacement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles darin wird ebenfalls gelöscht. Die Kleidungsstücke haben dann keinen Ort mehr."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrà eliminato anche tutto ciò che contiene. I capi resteranno senza posto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo o que há dentro também será apagado. As peças ficarão sem lugar."
          }
        }
      }
    },
    "Se eliminarán también sus muebles y compartimentos. Las prendas no se borran: quedarán sin ubicación.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its furniture and compartments will also be deleted. Items aren’t deleted; they’ll be left without a place."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses meubles et compartiments seront aussi supprimés. Les vêtements ne sont pas supprimés : ils n’auront plus d’emplacement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seine Möbel und Fächer werden ebenfalls gelöscht. Kleidungsstücke bleiben erhalten, haben aber keinen Ort mehr."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verranno eliminati anche i mobili e gli scomparti. I capi non vengono eliminati: resteranno senza posto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus móveis e compartimentos também serão apagados. As peças não são apagadas: ficarão sem lugar."
          }
        }
      }
    },
    "Se han añadido %lld prendas, %lld ubicaciones, %lld personas, %lld looks y %lld maletas. %lld elementos ya estaban y no se han duplicado.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Added %1$lld items, %2$lld places, %3$lld people, %4$lld looks and %5$lld trips. %6$lld were already there and weren’t duplicated."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld vêtements, %2$lld emplacements, %3$lld personnes, %4$lld looks et %5$lld valises ajoutés. %6$lld éléments existaient déjà et n’ont pas été dupliqués."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld Kleidungsstücke, %2$lld Orte, %3$lld Personen, %4$lld Looks und %5$lld Koffer hinzugefügt. %6$lld Elemente waren schon vorhanden und wurden nicht doppelt angelegt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunti %1$lld capi, %2$lld posti, %3$lld persone, %4$lld look e %5$lld valigie. %6$lld elementi c’erano già e non sono stati duplicati."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Foram adicionadas %1$lld peças, %2$lld lugares, %3$lld pessoas, %4$lld looks e %5$lld malas. %6$lld itens já existiam e não foram duplicados."
          }
        }
      }
    },
    "Se sincronizará en cuanto iCloud vuelva a estar disponible.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It will sync as soon as iCloud is available again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation reprendra dès qu’iCloud sera de nouveau disponible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Synchronisierung erfolgt, sobald iCloud wieder verfügbar ist."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si sincronizzerà appena iCloud sarà di nuovo disponibile."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Será sincronizado assim que o iCloud estiver disponível de novo."
          }
        }
      }
    },
