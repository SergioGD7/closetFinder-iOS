    "Prendas guardadas que no te pones desde hace más de seis meses. Buenas candidatas para darles uso o donarlas.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stored items you haven’t worn for over six months. Good candidates to wear again or donate."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vêtements rangés que vous n’avez pas portés depuis plus de six mois. De bons candidats à reporter ou à donner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verstaute Kleidungsstücke, die du seit über sechs Monaten nicht getragen hast. Gute Kandidaten zum Tragen oder Spenden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Capi riposti che non indossi da più di sei mesi. Buoni candidati da rimettere o donare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Peças guardadas que você não usa há mais de seis meses. Boas candidatas para usar ou doar."
          }
        }
      }
    },
