    "Calculadas con tablas europeas habituales. Cada marca talla un poco distinto: úsalas como referencia.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculated with common European size charts. Every brand fits a little differently, so use them as a guide."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculées avec les tableaux européens courants. Chaque marque taille un peu différemment : utilisez-les comme repère."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Berechnet mit üblichen europäischen Größentabellen. Jede Marke fällt etwas anders aus: nutze sie als Orientierung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcolate con le tabelle europee più comuni. Ogni marca veste in modo un po’ diverso: usale come riferimento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
