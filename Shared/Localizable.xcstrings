    "Esta copia se hizo con una versión más nueva de Closet Finder. Actualiza la app para restaurarla.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This backup was made with a newer version of Closet Finder. Update the app to restore it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette sauvegarde a été créée avec une version plus récente de Closet Finder. Mettez l’app à jour pour la restaurer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Sicherung wurde mit einer neueren Version von Closet Finder erstellt. Aktualisiere die App, um sie wiederherzustellen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
