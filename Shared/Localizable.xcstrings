            "state": "translated",
            "value": "Use a flexible tape measure and don’t pull tight. All are optional."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez un mètre ruban souple sans serrer. Toutes sont facultatives."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende ein flexibles Maßband und ziehe nicht fest. Alle Angaben sind optional."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa un metro da sarta morbido e non stringere. Sono tutte facoltative."
