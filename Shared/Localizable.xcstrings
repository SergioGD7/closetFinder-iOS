          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Capi non indossati, look di oggi, preferiti, in prestito o una categoria, con dove si trova ognuno."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
