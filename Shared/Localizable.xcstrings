    "Haz una foto a una prenda y di dónde la guardas. Así sabrás siempre dónde está.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take a photo of an item and say where you keep it. You’ll always know where it is."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenez un vêtement en photo et indiquez où vous le rangez. Vous saurez toujours où il est."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografiere ein Kleidungsstück und gib an, wo du es aufbewahrst. So weißt du immer, wo es ist."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
