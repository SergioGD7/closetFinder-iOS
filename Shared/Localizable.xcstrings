    "Planifica qué ponerte cada día. Al abrir el look verás dónde está cada prenda.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan what to wear each day. Open the look to see where every item is."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Planifiez quoi porter chaque jour. En ouvrant le look, vous verrez où est chaque vêtement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Plane, was du an jedem Tag trägst. Im Look siehst du, wo jedes Teil ist."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pianifica cosa indossare ogni giorno. Aprendo il look vedrai dove si trova ogni capo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Planeje o que vestir a cada dia. Ao abrir o look, você verá onde está cada peça."
          }
        }
      }
    },
