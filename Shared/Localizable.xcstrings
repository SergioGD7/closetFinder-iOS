        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec votre taille, votre tour de poitrine, de taille et votre pied, nous calculons vos tailles et vous disons si un vêtement vous va."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
