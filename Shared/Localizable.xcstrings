          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunti %1$lld capi, %2$lld posti e %3$lld persone. %4$lld elementi c’erano già e non sono stati duplicati."
          }
        },
        "pt-BR": {
          "stringUnit": {
